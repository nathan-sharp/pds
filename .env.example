# ARC PDS (Anthro Research Corporation) Environment Configuration
PROJECT_NAME="ARC PDS"
API_V1_STR="/api/v1"

# Cryptographic Master HMAC Secret (Minimum 32 bytes of entropy. Generate via: openssl rand -hex 32)
SECRET_KEY="replace-with-a-cryptographically-secure-random-32-byte-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration
# Local SQLite fallback: sqlite+aiosqlite:///./pds.db
# Production PostgreSQL: postgresql+asyncpg://pds_user:pds_secret_password@postgres:5432/pds_db
DATABASE_URL="postgresql+asyncpg://pds_user:pds_secret_password@postgres:5432/pds_db"

# Allowed CORS Origins (Comma-separated in environment if needed)
# CORS_ORIGINS=["http://localhost:3000"]
